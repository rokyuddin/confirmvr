PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me
# Vercel/cron: GET /api/cron/tick must send "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=change-me

# Database: Postgres (Neon) when set, otherwise local SQLite file
DATABASE_URL=
# DB_PATH=./data/confirmvr.db

# Call rules (Asia/Dhaka)
CALL_WINDOW_START=9
CALL_WINDOW_END=21
FIRST_CALL_DELAY_MIN=2
RETRY_DELAYS_MIN=30,120

# Billing (see src/pricing.js for packs)
FREE_CALLS_PER_MONTH=50
CREDITS_PER_CALL=1
TAKA_PER_CREDIT=1.5
BKASH_MERCHANT_NUMBER=01XXXXXXXXX
BKASH_WEBHOOK_SECRET=

# Voice: mock (no real calls) | http (local IPTSP REST API)
VOICE_PROVIDER=mock
MOCK_AUTO_ANSWER=
VOICE_API_URL=
VOICE_API_KEY=
VOICE_CALLER_ID=
VOICE_WEBHOOK_SECRET=

# Bangla TTS via Azure Speech (optional, free tier 0.5M chars/month)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TTS_VOICE=bn-BD-NabanitaNeural
TTS_FORMAT=audio-16khz-32kbitrate-mono-mp3

# OpenRouter (optional): spoken-Bangla product names + parse pasted Messenger orders
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: POST seller notifications to an SMS/Telegram bridge
NOTIFY_WEBHOOK_URL=

# Courier: fake bookings in development (Steadfast has no sandbox!)
COURIER_DRY_RUN=1
